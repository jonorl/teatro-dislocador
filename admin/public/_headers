# Cloudflare Pages applies these to every response. The CSP is report-only for now: browsers log what it would
# block in the console. Once sign-in and editing stay clean, rename the header to Content-Security-Policy.
# Clerk runs on clerk.teatrodislocador.ar; TinyMCE loads from cdn.tiny.cloud.
/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://clerk.teatrodislocador.ar https://challenges.cloudflare.com https://cdn.tiny.cloud https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tiny.cloud; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com https://cdn.tiny.cloud; connect-src 'self' https://api.teatrodislocador.ar https://clerk.teatrodislocador.ar https://cdn.tiny.cloud https://sp.tinymce.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://cloudflareinsights.com https://www.google.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Built files carry a content hash in their name, so a changed file always gets a new name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
