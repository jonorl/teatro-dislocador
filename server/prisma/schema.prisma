datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Class {
  id          String      @id @default(uuid())
  title       String
  description String?
  schedule    String
  image       String?  // ← add this
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Showcase {
  id          String      @id @default(uuid())
  title       String
  author      String?
  director    String?
  dates       String
  duration    String?
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gallery {
  id        String      @id @default(uuid())
  url       String
  createdAt DateTime @default(now())
}